# Copy this to .env and fill in what you need. The agents load .env automatically;
# nothing here is required to re-score the shipped regexes or reproduce the
# paper's tables.

# --- Running the FoRGe agent (splunk_rule_testing/agent.py) ---
# Gemini via Vertex AI. The plain Gemini API path ignores this and takes the key
# from --gemini-api-key or a gemini.txt file instead.
VERTEX_PROJECT=

# --- FoRGe's OpenAI provider and the Codex CLI baseline ---
# FORGE_PROVIDER=openai routes FoRGe through llm_openai.py; this is how the
# GPT-5.6 Luna same-model control was run.
FORGE_PROVIDER=gemini
FORGE_OPENAI_MODEL=gpt-5.6-luna
FORGE_OPENAI_EFFORT=none
OPENAI_API_KEY=
CODEX_HOME=

# --- Claude Code baseline (splunk_rule_testing/claude/) ---
# Port of a local LiteLLM proxy, used only when no Anthropic credentials are set.
CLAUDE_GEMINI_PROXY_PORT=4000

# --- Replaying the as-run prompts (scripts/eval_analysis/) ---
# Override the absolute prefix rewritten out of the shipped prompt templates.
LEGACY_PROMPT_PREFIX=
LEGACY_PROMPT_PATH_PATTERNS=
LEGACY_PROMPT_PATH_LITERALS=

# --- Detection engines (splunk_rule_testing/detection/) ---
# Verify TLS against Splunk's REST API. Off by default to match the local
# self-signed dev instance the experiments ran against.
FORGE_SPLUNK_VERIFY_TLS=0
# Allow --python-mode to execute model-generated code outside Docker. Leave at 0.
FORGE_ALLOW_UNSANDBOXED_EXEC=0

# --- Split reference tree (splunk_rule_testing/evaluate_test_split.py) ---
# Only used by --smoke-test-partition; unused by the published tables.
PARTITION_REFERENCE_ROOT=
